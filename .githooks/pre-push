#!/usr/bin/env bash
# Faithful pre-push gate: run what CI gates on. NB the gate checks the WORKING
# TREE; CI checks the pushed commits — they agree exactly when the tree is
# clean, so the warnings below call out any divergence instead of hiding it.
# The fast inner loop (raw uv) uses prebuilt wheels and can pass while the
# Nix-built closure (CI's `nix flake check`) fails on native-linking or
# lockfile drift — that is the gap this hook closes.
#
# Auto-installed by the devShell shellHook (`git config core.hooksPath .githooks`).
# Bypass: `git push --no-verify`, or `MYPROJECT_SKIP_PREPUSH=1 git push`.
set -euo pipefail

if [ -n "${MYPROJECT_SKIP_PREPUSH:-}" ]; then
  echo "pre-push: skipped (MYPROJECT_SKIP_PREPUSH set)"
  exit 0
fi

# git feeds "<local-ref> <local-sha> <remote-ref> <remote-sha>" per ref on
# stdin. Ref deletions and tag pushes push no new code — skip the gate for
# them rather than charging minutes for `git push origin :stale-branch`.
zero=0000000000000000000000000000000000000000
needs_check=0
while read -r _ local_sha remote_ref _; do
  if [ "$local_sha" = "$zero" ]; then continue; fi
  case "$remote_ref" in refs/tags/*) continue ;; esac
  needs_check=1
done
if [ "$needs_check" -eq 0 ]; then
  echo "pre-push: only ref deletions / tag pushes — skipping the gate"
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

# Divergence warnings: dirty tracked files are seen by BOTH local gates but not
# by CI; untracked files are seen by `make check` but invisible to `nix flake
# check` (the flake source is git-tracked files only) and to CI.
if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "pre-push: NOTE — working tree is dirty; the gate checks the tree, CI checks the pushed commits" >&2
fi
if [ -n "$(git ls-files --others --exclude-standard)" ]; then
  echo "pre-push: NOTE — untracked files exist; \`nix flake check\` and CI cannot see them" >&2
fi

# uv inner loop (ruff + basedpyright + pytest) — the fast, always-available gate.
echo "pre-push › make check (uv inner loop)"
make check || {
  echo "pre-push: make check FAILED — fix it, or bypass with 'git push --no-verify' / MYPROJECT_SKIP_PREPUSH=1" >&2
  exit 1
}

# Nix-faithful gate: statix + nixfmt + the test suite inside the uv2nix closure
# (catches native-linking failures + flake-formatting the uv path can't see).
# NB `nix flake check` does NOT typecheck — `make check` above covers that.
if command -v nix >/dev/null 2>&1; then
  echo "pre-push › nix flake check (statix + nixfmt + pytest-in-closure; may build the closure — minutes when cold)"
  nix flake check --print-build-logs || {
    echo "pre-push: nix flake check FAILED — fix it, or bypass with 'git push --no-verify' / MYPROJECT_SKIP_PREPUSH=1" >&2
    exit 1
  }
else
  echo "pre-push: nix not found — skipping the Nix-faithful gate (CI still runs it)" >&2
fi
